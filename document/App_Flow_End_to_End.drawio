ell><mxCell id="m_sup" value="&lt;b&gt;Add suppliers &amp;amp; components&lt;/b&gt;&lt;br&gt;shared by all factories" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="330.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_mat" value="&lt;b&gt;Add material&lt;/b&gt;&lt;br&gt;name, category, Mea (UoM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="560.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_var" value="&lt;b&gt;Add variant&lt;/b&gt;&lt;br&gt;Material Code, colour, thickness" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="790.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_erp" value="Material Code from the factory ERP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="lane0"><mxGeometry x="790.0" y="29.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_sim" value="Shows similar names while typing (search first, then create)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="lane2"><mxGeometry x="330.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_dup" value="Duplicate code, or same material + thickness + colour?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="lane2"><mxGeometry x="795.0" y="29.0" width="170" height="112" as="geometry"/></mxCell><mxCell id="m_mean" value="Code part already means something else in this factory?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="lane2"><mxGeometry x="1025.0" y="29.0" width="170" height="112" as="geometry"/></mxCell><mxCell id="m_conf" value="Tick &lt;i&gt;checked, code matches ERP&lt;/i&gt; and save" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="1020.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_ok" value="&lt;b&gt;Variant ACTIVE&lt;/b&gt;&lt;br&gt;thickness standardised; matching yellow cells linked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="lane2"><mxGeometry x="1250.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_link" value="&lt;b&gt;Link supplier(s)&lt;/b&gt; to the material" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="1480.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_prop" value="&lt;b&gt;Propose price&lt;/b&gt;&lt;br&gt;1 supplier, many variants, currency, valid from (or copy from another variant)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane3"><mxGeometry x="1710.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_dec" value="Approve? (per line)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="lane4"><mxGeometry x="1945.0" y="24.0" width="170" height="112" as="geometry"/></mxCell><mxCell id="m_rej" value="Sees rejected price in Home, proposes again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane3"><mxGeometry x="1940.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_act" value="&lt;b&gt;Price ACTIVE&lt;/b&gt;&lt;br&gt;old price for the same variant × supplier closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="lane4"><mxGeometry x="2170.0" y="44.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="m_end" value="Used by CBD price lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#122A52;strokeColor=#122A52;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="lane4"><mxGeometry x="2415.0" y="55.0" width="150" height="50" as="geometry"/></mxCell><mxCell id="m_note" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Only 1 pending proposal per variant × supplier&lt;br&gt;• Manager Costing's own price is active at once&lt;br&gt;• Only Manager Costing can end a price" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="lane4"><mxGeometry x="1195.0" y="32.0" width="230" height="96" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_start" target="m_sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_sup" target="m_mat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_mat" target="m_var"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize