/mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Master data &amp; prices"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Master data &amp;amp; material prices" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#122A52;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1400" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Master data needs no approval. Only material prices are approved, by Manager Costing. Materials, variants and prices belong to one factory; suppliers and components are shared." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="46" width="1500" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="Start / end" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#122A52;strokeColor=#122A52;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2005" y="70" width="115" height="42" as="geometry"/></mxCell><mxCell id="lg1" value="Step by a user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2130" y="70" width="115" height="42" as="geometry"/></mxCell><mxCell id="lg2" value="Done by the app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2255" y="70" width="115" height="42" as="geometry"/></mxCell><mxCell id="lg3" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2380" y="70" width="115" height="42" as="geometry"/></mxCell><mxCell id="lg4" value="Outside the app" style="roun