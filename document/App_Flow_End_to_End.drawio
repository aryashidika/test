om" value="&lt;b&gt;Fill BOM&lt;/b&gt;&lt;br&gt;material · thickness, supplier, process; colour per article" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane0"><mxGeometry x="1020.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="s_has" value="Colour has a registered variant?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="lane1"><mxGeometry x="1025.0" y="29.0" width="170" height="112" as="geometry"/></mxCell><mxCell id="s_erp" value="Material team gives the Material Code from ERP (Excel export marks &lt;i&gt;(no code)&lt;/i&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;" vertex="1" parent="lane2"><mxGeometry x="1020.0" y="39.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="s_reg" value="&lt;b&gt;Register&lt;/b&gt; the code on the yellow cell" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane0"><mxGeometry x="1250.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="s_link" value="Cell linked to Material Code; all matching yellow cells link too" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="lane1"><mxGeometry x="1480.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="s_pub" value="&lt;b&gt;Publish&lt;/b&gt;&lt;br&gt;choose stage, write reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="lane0"><mxGeometry x="1480.0" y="49.0" width="180" height="72" as="geometry"/></mxCell><mxCell id="s_chk" value="Checklist OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="lane1"><mxGeometry x="